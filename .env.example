# Norman — Environment Variables
# Copy to .env and adjust values as needed.
# These override YAML config and are read by both client and server.
#
# Priority order: env vars > .env files > config.yaml > embedded defaults

# Server listen port (default: 8080)
NORMAN_PORT=8080

# Bind address for server + OpenShell gateway (default: 127.0.0.1)
NORMAN_HOST=127.0.0.1

# External-facing server URL (e.g., https://norman.example.com).
# Overrides auto-derived http://host:port URL.
# NORMAN_SERVER_URL=

# Base directory for workspaces (default: ~/.norman/workspaces)
# NORMAN_BASE_DIR=~/.norman/workspaces

# Enable verbose/debug logging (true/false or 1/0)
NORMAN_VERBOSE=false

# Memory store directory (default: $HOME/.norman/store)
# NORMAN_STORE_DIR=$HOME/.norman/store

# Raw sources store directory (default: $HOME/.norman/raw_sources)
# NORMAN_RAW_SOURCES_DIR=$HOME/.norman/raw_sources
