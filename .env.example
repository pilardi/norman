# Norman — Environment Variables
# Copy to .env and adjust values as needed.
# These override YAML config and are read by both client and server.

# Server listen port (default: 8080)
PORT=8080

# Bind address for server + OpenShell gateway (default: 127.0.0.1)
HOST=127.0.0.1

# Enable verbose/debug logging (true/false or 1/0)
LOGGING_VERBOSE=false
